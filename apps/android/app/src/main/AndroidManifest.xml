<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Kiosco: horizontal (la tablet va en un soporte) y en una sola tarea.
      Lo que impide salirse es fijar la pantalla o el modo dispositivo dedicado:
      ver README.
    -->
    <application
        android:label="Asta Kiosco"
        android:icon="@drawable/asta_logo"
        android:theme="@style/Tema.Kiosco"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
