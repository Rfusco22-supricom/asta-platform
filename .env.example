# ── Odoo ─────────────────────────────────────────────────────────────────────
# OJO: sin prefijo NEXT_PUBLIC_. Estas variables son de servidor y no deben
# llegar nunca al bundle del navegador.
ODOO_URL=https://supricom2.odoo.com
ODOO_DB=supricom-prod1-25424683
# Login del usuario de servicio. XML-RPC authenticate() necesita login + API key.
ODOO_USERNAME=api-middleware@supricom.com.ve
# API key de Odoo (Preferencias > Seguridad de la cuenta > Claves de API).
# Es revocable sin cambiar la contraseña del usuario.
ODOO_PASSWORD=
ODOO_TIMEOUT_MS=15000

# A partir de cuantos ms una llamada a Odoo se registra como lenta (nivel warn).
# Por debajo salen en debug, que en produccion no se imprime: asi con
# LOG_LEVEL=info

# Quien puede hablar en nombre del cliente final (issue #52).
# El navegador nunca llama al middleware: todo pasa por el servidor de Next. A
# los pares listados aqui se les cree el X-Forwarded-For y el user-agent real
# que reenvia el panel; a los demas no, porque si no cualquiera podria
# falsificar la IP y el dispositivo que quedan registrados en la sesion.
# Valores de Express: loopback, linklocal, uniquelocal, una lista de IPs/CIDR
# separada por comas, o un numero de saltos.
# En EasyPanel habra que poner la red del contenedor, no dejar loopback.
TRUSTED_PROXIES=loopback solo asoman las llamadas que de verdad arrastran.
ODOO_SLOW_RPC_MS=2000

# Nivel de log: fatal, error, warn, info, debug, trace.
# En `debug` se ve CADA llamada a Odoo con su duracion (ver issue #10); en
# `info`, solo las que pasan de ODOO_SLOW_RPC_MS. Para produccion, `info`.
LOG_LEVEL=info
ODOO_DEFAULT_LANG=es_MX
ODOO_DEFAULT_TZ=America/Caracas

# ── MySQL ────────────────────────────────────────────────────────────────────
# Requiere MySQL 8.0.13 o superior. Comprobar con: SELECT VERSION();
# MariaDB no sirve tal cual (no soporta DEFAULT (UUID()) de la misma forma).
#
# CODIFICA LOS CARACTERES ESPECIALES DE LA CONTRASEÑA. En un DSN, @ separa las
# credenciales del host, así que una contraseña como "Clave2015@" debe ir como
# "Clave2015%40". Sin eso Prisma parsea mal la URL y el error no apunta a la
# contraseña, así que se pierde un buen rato buscando en el sitio equivocado.
#   @ -> %40    : -> %3A    / -> %2F    # -> %23    ? -> %3F
#
# El host depende de dónde corra el middleware: un nombre de servicio de Docker
# (p.ej. dashboard_database) solo resuelve entre contenedores de esa red.
# Conexion a MySQL.
#
# EN PRODUCCION ESTO DEBE SER asta_app, NO root (issue #44).
#
#   DATABASE_URL=mysql://asta_app:LA_CLAVE@host:3306/asta
#
# asta_app no puede borrar filas ni cambiar el esquema ni reescribir la
# auditoria. Se comprobo que la aplicacion entera funciona asi: 206 tests pasan
# y lo unico denegado es el DELETE de limpieza de los propios tests.
#
# Las credenciales de asta_migrador NO van aqui: ese usuario aplica migraciones
# a mano, en una ventana controlada. Si su clave vive en el .env del despliegue,
# tener dos usuarios no sirve de nada.
#
# Ojo con los caracteres especiales: en un DSN la @ separa credenciales de host,
# asi que "Clave2015@" se escribe "Clave2015%40".
#
# En desarrollo local root vale: es una base de desarrollo, y los tests
# necesitan DELETE para limpiar sus fixtures.
DATABASE_URL=mysql://asta:PASSWORD@localhost:3306/asta

# ── Seguridad ────────────────────────────────────────────────────────────────
# Pepper del HMAC de las API keys. Generar con: openssl rand -base64 48
# Vive SOLO aquí, nunca en la base: si se filtra la tabla api_keys, los hashes
# sin el pepper no permiten verificar ni un token.
# Rotarlo SIN API_KEY_PEPPER_ANTERIOR invalida TODAS las API keys emitidas.
# Procedimiento: docs/08-ROTACION-PEPPER.md
API_KEY_PEPPER=

# Solo durante una rotación del pepper: el valor que se retira. Vacío el resto
# del tiempo. Ver docs/08-ROTACION-PEPPER.md
API_KEY_PEPPER_ANTERIOR=

# Firma de los JWT de sesión. Mínimo 32 caracteres.
# Generar con: openssl rand -base64 48
# Rotarla invalida TODAS las sesiones activas.
JWT_SECRET=
JWT_ISSUER=asta-middleware
JWT_AUDIENCE=asta-panel
# El access token no se puede revocar, por eso dura poco. La sesión que sí se
# cierra es el refresh token, que vive en user_sessions.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ── Argon2id ─────────────────────────────────────────────────────────────────
# Estos NO son los valores mínimos de OWASP (m=19456, t=2), que están pensados
# para el hardware más lento posible. Medidos en la máquina de desarrollo, ese
# mínimo se resuelve en 14 ms: demasiado barato, porque el coste de crackear es
# proporcional al de calcular. m=65536, t=3 da ~68 ms.
#
# CUIDADO EN EL VPS: son 64 MiB POR HASH EN CURSO. Diez logins simultáneos son
# 640 MiB. Si el servidor va justo de RAM, baja ARGON2_MEMORY_KIB antes que
# quitar el límite de intentos del login.
#
# Recalibra en el servidor real con:
#   pnpm --filter @asta/middleware exec tsx src/auth/benchmark.ts
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1

# Bloqueo por intentos fallidos. Se cuenta por usuario, no por IP: un atacante
# rota IPs con facilidad, pero la cuenta objetivo sigue siendo la misma.
LOGIN_MAX_ATTEMPTS=8
# El personal (VENDEDOR, SUPERADMIN) entra también con su contraseña de Odoo (#85).
# false lo apaga en el acto: solo queda la contraseña del panel.
LOGIN_ODOO=true
LOGIN_LOCKOUT_MINUTES=15

# ── Correo (invitaciones y reseteo de contraseña) ────────────────────────────
# También lo cubría Supabase. Ahora hace falta un SMTP propio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@supricom.com.ve

# ── Aplicación ───────────────────────────────────────────────────────────────
WEB_APP_ORIGIN=http://localhost:3000
PORT=3001
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# Alertas de operacion (issue #46) — `pnpm alertas`
#
# Todas son OPCIONALES y todas tienen valor por defecto, asi que no se declaran
# en los schemas de arranque: `exigirEntornoValido()` informaria de cosas que no
# pueden faltar. Se documentan aqui porque es donde la gente las busca.
#
# Los valores por defecto estan puestos con criterio pero SIN datos de
# produccion detras. Conviene revisarlos con un mes de trafico real: una alerta
# mal calibrada se silencia, y una alerta silenciada es peor que ninguna porque
# da sensacion de cobertura.
# ─────────────────────────────────────────────────────────────────────────────

# A donde se mandan las alertas ademas de la salida estandar. Sirve cualquier
# webhook que acepte {"text": "..."} — Slack, Discord, un puente a Telegram.
# Sin esto, las alertas salen por stdout y por codigo de salida, que ya sirve
# para un cron. Por correo NO se mandan: no hay SMTP (mismo bloqueo que #53).
# ALERTAS_WEBHOOK_URL=

# ALERTA_VENTANA_MIN=15          # ventana de las reglas por tasa
# ALERTA_SYNC_HORAS=6            # horas sin sincronizar antes de avisar
# ALERTA_SYNC_COLGADO_MIN=30     # minutos con el cerrojo del sync puesto
# ALERTA_ACCESOS_CRUZADOS=5      # intentos de acceso ajeno en la ventana
# ALERTA_ODOO_P95_MS=3000        # p95 de Odoo en ms
# ALERTA_TASA_5XX=5              # porcentaje de 5xx
# ALERTA_KEY_401=10              # rechazos de una misma API key
# ALERTA_ODOO_CALLS=5            # RPC por peticion (deteccion de N+1)
# ALERTA_KIOSCO_MIN=30           # minutos sin senal de un kiosco
# ALERTA_KIOSCO_TZ=America/Caracas
# ALERTA_KIOSCO_ABRE=8
# ALERTA_KIOSCO_CIERRA=19

# Registro de CADA consulta de Prisma. Apagado por defecto: encendido ahoga el
# log del servidor y la salida de todos los scripts.
# PRISMA_LOG_QUERIES=1

# Commit que lleva el build, para poder preguntarle a /health que codigo corre.
# En desarrollo no hace falta: sin el, /health informa de la FECHA del bundle,
# que se calcula sola. En la imagen se pasa como build arg, no por aqui:
#   docker build --build-arg VERSION_SHA=$(git rev-parse --short HEAD) ...
# VERSION_SHA=
