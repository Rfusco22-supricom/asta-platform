# ── Odoo ─────────────────────────────────────────────────────────────────────
# OJO: sin prefijo NEXT_PUBLIC_. Estas variables son de servidor y no deben
# llegar nunca al bundle del navegador.
ODOO_URL=https://supricom2.odoo.com
ODOO_DB=supricom-prod1-25424683
# Login del usuario de servicio. XML-RPC authenticate() necesita login + API key.
ODOO_USERNAME=api-middleware@supricom.com.ve
# API key de Odoo (Preferencias > Seguridad de la cuenta > Claves de API).
# Es revocable sin cambiar la contraseña del usuario.
ODOO_PASSWORD=
ODOO_TIMEOUT_MS=15000

# A partir de cuantos ms una llamada a Odoo se registra como lenta (nivel warn).
# Por debajo salen en debug, que en produccion no se imprime: asi con
# LOG_LEVEL=info solo asoman las llamadas que de verdad arrastran.
ODOO_SLOW_RPC_MS=2000
ODOO_DEFAULT_LANG=es_MX
ODOO_DEFAULT_TZ=America/Caracas

# ── MySQL ────────────────────────────────────────────────────────────────────
# Requiere MySQL 8.0.13 o superior. Comprobar con: SELECT VERSION();
# MariaDB no sirve tal cual (no soporta DEFAULT (UUID()) de la misma forma).
#
# CODIFICA LOS CARACTERES ESPECIALES DE LA CONTRASEÑA. En un DSN, @ separa las
# credenciales del host, así que una contraseña como "Clave2015@" debe ir como
# "Clave2015%40". Sin eso Prisma parsea mal la URL y el error no apunta a la
# contraseña, así que se pierde un buen rato buscando en el sitio equivocado.
#   @ -> %40    : -> %3A    / -> %2F    # -> %23    ? -> %3F
#
# El host depende de dónde corra el middleware: un nombre de servicio de Docker
# (p.ej. dashboard_database) solo resuelve entre contenedores de esa red.
DATABASE_URL=mysql://asta:PASSWORD@localhost:3306/asta

# ── Seguridad ────────────────────────────────────────────────────────────────
# Pepper del HMAC de las API keys. Generar con: openssl rand -base64 48
# Vive SOLO aquí, nunca en la base: si se filtra la tabla api_keys, los hashes
# sin el pepper no permiten verificar ni un token.
# Rotarlo invalida TODAS las API keys emitidas.
API_KEY_PEPPER=

# Firma de los JWT de sesión. Mínimo 32 caracteres.
# Generar con: openssl rand -base64 48
# Rotarla invalida TODAS las sesiones activas.
JWT_SECRET=
JWT_ISSUER=asta-middleware
JWT_AUDIENCE=asta-panel
# El access token no se puede revocar, por eso dura poco. La sesión que sí se
# cierra es el refresh token, que vive en user_sessions.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ── Argon2id ─────────────────────────────────────────────────────────────────
# Estos NO son los valores mínimos de OWASP (m=19456, t=2), que están pensados
# para el hardware más lento posible. Medidos en la máquina de desarrollo, ese
# mínimo se resuelve en 14 ms: demasiado barato, porque el coste de crackear es
# proporcional al de calcular. m=65536, t=3 da ~68 ms.
#
# CUIDADO EN EL VPS: son 64 MiB POR HASH EN CURSO. Diez logins simultáneos son
# 640 MiB. Si el servidor va justo de RAM, baja ARGON2_MEMORY_KIB antes que
# quitar el límite de intentos del login.
#
# Recalibra en el servidor real con:
#   pnpm --filter @asta/middleware exec tsx src/auth/benchmark.ts
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1

# Bloqueo por intentos fallidos. Se cuenta por usuario, no por IP: un atacante
# rota IPs con facilidad, pero la cuenta objetivo sigue siendo la misma.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# ── Correo (invitaciones y reseteo de contraseña) ────────────────────────────
# También lo cubría Supabase. Ahora hace falta un SMTP propio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@supricom.com.ve

# ── Aplicación ───────────────────────────────────────────────────────────────
WEB_APP_ORIGIN=http://localhost:3000
PORT=3001
NODE_ENV=development
