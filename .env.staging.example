# ─────────────────────────────────────────────────────────────────────────────
# Batería de staging (#13) — `pnpm test:staging`
#
# Copia este fichero a `.env.staging` (que git ignora) y rellénalo con el Odoo
# de STAGING. La batería ESCRIBE en él: crea pedidos con el escritor real (#33)
# y los cancela al terminar.
#
# `apps/middleware/src/odoo/entornoStaging.ts` se niega a arrancar si la base o
# el host son los de producción, si falta ODOO_STAGING=si, o si el MySQL no es
# local. Ver `docs/11-STAGING.md`.
# ─────────────────────────────────────────────────────────────────────────────

# Dicho a propósito: esto es staging.
ODOO_STAGING=si

# El Odoo de staging. En Odoo.sh, el de la rama de staging (otro host, otra base).
ODOO_URL=https://supricom-staging-XXXXXXX.dev.odoo.com
ODOO_DB=supricom-staging-XXXXXXX
ODOO_USERNAME=
# API key del usuario de servicio EN STAGING (las de producción no se copian).
ODOO_PASSWORD=
ODOO_TIMEOUT_MS=30000
ODOO_DEFAULT_LANG=es_MX
ODOO_DEFAULT_TZ=America/Caracas

# MySQL LOCAL. La batería escribe también aquí (claves de idempotencia).
DATABASE_URL=mysql://root@localhost:3306/asta

# El resto, como en el .env de desarrollo.
JWT_SECRET=clave-de-pruebas-con-mas-de-treinta-y-dos-caracteres
DEV_AUTH_ENABLED=true

# Si algún día hay más bases o hosts de producción, se AÑADEN aquí (separados
# por comas). Los de esta instalación ya están por defecto y no se pueden quitar.
# ODOO_DB_PRODUCCION=
# ODOO_HOST_PRODUCCION=
