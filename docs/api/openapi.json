    "/api/v1/public/inventory": {
      "get": {
        "operationId": "listarInventario",
        "summary": "Consultar existencias",
        "description": "Productos a la venta con su existencia en el almacén que te vende, descontando lo ya reservado. Se publica como estado, no como cantidad. Sin precios: llegarán con el endpoint de precios. Las respuestas pueden venir de una cache de hasta 60 segundos (`meta.desdeCache`).\n\nPermiso necesario: `INVENTORY_READ`.",
        "tags": [
          "Inventario"
        ],
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "sku",
            "in": "query",
            "required": false,
            "description": "Referencia exacta del producto.",
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Busca en el nombre y la referencia, sin distinguir mayúsculas. Mínimo 2 caracteres.",
            "schema": {
              "type": "string",
              "minLength": 2
            }
          },
          {
            "name": "printerId",
            "in": "query",
            "required": false,
            "description": "Reservado para filtrar por impresora compatible. Todavía no disponible: responde 400.",
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          {
            "name": "soloDisponibles",
            "in": "query",
            "required": false,
            "description": "`true` para devolver solo productos con existencia (`disponible` o `bajo`).",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "required": false,
            "description": "Página, empezando en 1.",
            "schema": {
              "default": 1,
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          {
            "name": "porPagina",
            "in": "query",
            "required": false,
            "description": "Resultados por página, hasta 100.",
            "schema": {
              "default": 50,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Una página de productos.",
            "headers": {
              "RateLimit-Limit": {
                "description": "Peticiones permitidas en la ventana.",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Remaining": {
                "description": "Peticiones que quedan en la ventana.",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Reset": {
                "description": "Segundos hasta que se reinicia la ventana.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "description": "Identificador del producto."
                          },
                          "templateId": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "description": "Identificador del producto base que agrupa sus variantes."
                          },
                          "sku": {
                            "description": "Referencia del producto. `null` si no tiene.",
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "nombre": {
                            "type": "string",
                            "description": "Nombre del producto."
                          },
                          "categoria": {
                            "description": "Categoría del producto. `null` si no tiene.",
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "stock": {
                            "type": "string",
                            "enum": [
                              "disponible",
                              "bajo",
                              "agotado"
                            ],
                            "description": "Existencia en el almacén que te vende, descontando lo ya reservado: `disponible`, `bajo` (pocas unidades) o `agotado`. Puede recibir valores nuevos: trata cualquier otro como `agotado`."
                          }
                        },
                        "required": [
                          "id",
                          "templateId",
                          "sku",
                          "nombre",
                          "categoria",
                          "stock"
                        ]
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "pagina": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "description": "Página devuelta."
                        },
                        "porPagina": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "description": "Tamaño de página aplicado."
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "Total de productos con estos filtros, en todas las páginas."
                        },
                        "desdeCache": {
                          "type": "boolean",
                          "description": "`true` si la respuesta sale de la cache: puede tener hasta 60 segundos de antigüedad."
                        }
                      },
                      "required": [
                        "pagina",
                        "porPagina",
                        "total",
                        "desdeCache"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                },
                "example": {
                  "data": [
                    {
                      "id": 2001,
                      "templateId": 3001,
                      "sku": "TON-0001",
                      "nombre": "TÓNER NEGRO DE EJEMPLO",
                      "categoria": "CONSUMIBLES",
                      "stock": "disponible"
                    }
                  ],
                  "meta": {
                    "pagina": 1,
                    "porPagina": 50,
                    "total": 1,
                    "desdeCache": false
                  }
                }
              }
            }
          },
          "400": {
            "description": "Códigos posibles: `INVALID_QUERY`, `PARTNER_ID_NOT_ALLOWED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Códigos posibles: `MISSING_API_KEY`, `INVALID_API_KEY`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Códigos posibles: `INSUFFICIENT_SCOPE`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Códigos posibles: `INVENTORY_UNAVAILABLE`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Códigos posibles: `RATE_LIMITED`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Segundos que hay que esperar.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "500": {
            "description": "Códigos posibles: `INTERNAL_ERROR`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Códigos posibles: `ODOO_UNAVAILABLE`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-codeSamples": [
          {
            "lang": "curl",
            "label": "curl",
            "source": "curl \"https://{servidor}/api/v1/public/inventory?q=toner&soloDisponibles=true\" \\\n  -H \"X-API-Key: $ASTA_API_KEY\""
          },
          {
            "lang": "Python",
            "label": "Python",
            "source": "import json, os, urllib.request\n\npeticion = urllib.request.Request(\n    \"https://{servidor}/api/v1/public/inventory?q=toner&soloDisponibles=true\",\n    headers={\"X-API-Key\": os.environ[\"ASTA_API_KEY\"]},\n)\nwith urllib.request.urlopen(peticion) as respuesta:\n    datos = json.load(respuesta)\nprint(datos)"
          }
        ]
      }
    }
