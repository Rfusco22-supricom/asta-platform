  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Tu API key. Se crea en el panel, en «Mis API keys»."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "Código del error. Programa contra él, no contra `message`. Pueden aparecer códigos nuevos: trátalos por su status HTTP.",
                "examples": [
                  "MISSING_API_KEY",
                  "INVALID_API_KEY",
                  "INSUFFICIENT_SCOPE",
                  "PARTNER_ID_NOT_ALLOWED",
                  "INVALID_QUERY",
                  "INVALID_INVOICE_ID",
                  "INVOICE_NOT_FOUND",
                  "INVOICE_PDF_NOT_AVAILABLE",
                  "LINK_NOT_VALID",
                  "LINK_EXPIRED",
                  "INVENTORY_UNAVAILABLE",
                  "RATE_LIMITED",
                  "VALIDATION_ERROR",
                  "ODOO_UNAVAILABLE",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "docs": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
