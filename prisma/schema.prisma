// ASTA — Esquema del Middleware (PostgreSQL / Supabase)
//
// Regla de oro: esta base NO duplica el negocio. Solo guarda lo que Odoo no debe
// guardar (tokens de API, sesiones, telemetría del kiosco) y un espejo mínimo de
// res.partner para que el login no dependa del uptime de Odoo.
//
// Todo lo que sea precio, stock, factura o producto se lee de Odoo en vivo.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")      // pooler (pgBouncer) para la app
  directUrl  = env("DIRECT_URL")        // conexión directa para migraciones
  extensions = [pgcrypto, citext]
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

/// Los 5 roles del sistema.
/// Nota de diseño: BRONCE / PLATA / GOLD son en realidad *tiers* del mismo rol
/// funcional (cliente). Se mantienen como valores del enum porque así está
/// definido el requerimiento, pero la lógica de permisos debe preguntar por
/// `isClientRole(role)` y no enumerar los tres a mano en cada `if`.
enum AppRole {
  SUPERADMIN
  VENDEDOR
  BRONCE
  PLATA
  GOLD
}

/// Permisos granulares que puede llevar una API Key.
/// Una key nunca debe nacer con todos los scopes: se piden explícitamente.
enum ApiScope {
  INVENTORY_READ // consultar stock y catálogo
  PRICING_READ // ver precios de SU tarifa
  INVOICES_READ // ver sus propias facturas
  ORDERS_READ // ver sus pedidos
  ORDERS_WRITE // crear pedidos (sale.order en estado draft)
  RECOMMENDER_READ // consultar compatibilidad impresora <-> tóner
}

enum ApiKeyEnv {
  LIVE
  TEST
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
  ORPHANED // existe aquí pero ya no en Odoo
}

// ─────────────────────────────────────────────────────────────────────────────
// IDENTIDAD
// ─────────────────────────────────────────────────────────────────────────────

/// Espejo de res.partner (clientes) y res.users (vendedores) de Odoo.
/// La contraseña NO vive aquí: la gestiona Supabase Auth (auth.users).
model AppUser {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// FK lógica a auth.users.id de Supabase. Null mientras el usuario no haya
  /// activado su cuenta (el registro puede crearse por sync desde Odoo antes).
  authUserId String? @unique @map("auth_user_id") @db.Uuid

  email    String  @unique @db.Citext
  fullName String  @map("full_name")
  phone    String?

  role AppRole

  // ── Vínculo con Odoo ──────────────────────────────────────────────────────
  /// res.partner.id — la llave que une los dos mundos. Inmutable.
  odooPartnerId    Int     @unique @map("odoo_partner_id")
  /// res.users.id — solo para SUPERADMIN y VENDEDOR. Necesario para filtrar
  /// account.move / res.partner por `user_id`.
  odooUserId       Int?    @unique @map("odoo_user_id")
  /// product.pricelist.id resuelto desde x_client_tier. Se cachea aquí para no
  /// hacer un RPC extra en cada request, y se refresca en cada sync.
  odooPricelistId  Int?    @map("odoo_pricelist_id")
  /// Valor crudo de x_client_tier tal como viene de Odoo, para depurar
  /// desalineaciones entre el tier de Odoo y el rol de aquí.
  odooClientTier   String? @map("odoo_client_tier")
  /// res.partner.commercial_partner_id — la empresa matriz. Es el ID correcto
  /// para agregar facturación cuando el cliente tiene sucursales.
  odooCommercialId Int?    @map("odoo_commercial_partner_id")

  // ── Vendedor asignado (self-relation) ─────────────────────────────────────
  assignedSalespersonId String?   @map("assigned_salesperson_id") @db.Uuid
  assignedSalesperson   AppUser?  @relation("SalespersonClients", fields: [assignedSalespersonId], references: [id], onDelete: SetNull)
  clients               AppUser[] @relation("SalespersonClients")

  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)

  syncStatus SyncStatus @default(PENDING) @map("sync_status")
  syncedAt   DateTime?  @map("synced_at") @db.Timestamptz(3)
  syncError  String?    @map("sync_error")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  apiKeys             ApiKey[]
  kioskSessions       KioskSession[]
  auditLogs           AuditLog[]             @relation("AuditActor")
  recommendationEvents RecommendationEvent[]

  @@index([role, isActive])
  @@index([assignedSalespersonId])
  @@index([odooCommercialId])
  @@map("app_users")
}

// ─────────────────────────────────────────────────────────────────────────────
// API KEYS
// ─────────────────────────────────────────────────────────────────────────────

/// Token que el cliente genera desde su panel.
///
/// Formato del token:  asta_live_<prefix:8>_<secret:43 en base64url>
///                     └─ público ─┘└ público ┘└──── secreto, 32 bytes ────┘
///
/// - `prefix` se guarda en claro e indexado -> encuentra la fila en O(1).
/// - `keyHash` = HMAC-SHA256(API_KEY_PEPPER, tokenCompleto), comparado con
///   `crypto.timingSafeEqual`. No usamos bcrypt: son ~100 ms por request y la
///   entropía de 256 bits aleatorios no necesita un KDF lento.
/// - El pepper vive en el entorno (no en la BD): si alguien exfiltra la tabla,
///   los hashes solos no le sirven.
/// - El secreto en claro se muestra UNA sola vez, al crearlo. Nunca se recupera.
model ApiKey {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  user   AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Nombre que le pone el usuario: "Integración con mi ERP", "Script de stock".
  name        String
  environment ApiKeyEnv @default(LIVE)

  prefix   String     @unique @db.VarChar(16)
  keyHash  String     @unique @map("key_hash") @db.VarChar(64)
  /// Últimos 4 caracteres, solo para que el usuario reconozca su key en la lista.
  lastFour String     @map("last_four") @db.VarChar(4)
  scopes   ApiScope[]

  rateLimitPerMinute Int @default(60) @map("rate_limit_per_minute")
  /// Lista blanca opcional de IPs/CIDR. Vacía = sin restricción de origen.
  allowedIps         String[] @default([]) @map("allowed_ips")

  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy String?   @map("revoked_by") @db.Uuid
  revokeReason String? @map("revoke_reason")

  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  lastUsedIp String?   @map("last_used_ip") @db.Inet
  usageCount BigInt    @default(0) @map("usage_count")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdFrom String?  @map("created_from_ip") @db.Inet

  requestLogs ApiRequestLog[]

  /// El índice parcial hace que el lookup del hot path solo recorra keys vivas.
  @@index([userId, revokedAt])
  @@index([keyHash])
  @@map("api_keys")
}

/// Bitácora de uso de la API pública. Alto volumen: candidata a particionar por
/// mes (`PARTITION BY RANGE (created_at)`) y a purgar a los 90 días.
model ApiRequestLog {
  id       BigInt  @id @default(autoincrement())
  apiKeyId String? @map("api_key_id") @db.Uuid
  apiKey   ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  /// Se guarda desnormalizado: si la key se borra, el log sigue siendo auditable.
  odooPartnerId Int?   @map("odoo_partner_id")
  method        String @db.VarChar(8)
  path          String @db.VarChar(255)
  statusCode    Int    @map("status_code")
  durationMs    Int    @map("duration_ms")
  /// Cuántos RPC a Odoo costó este request. Sirve para detectar N+1 contra el ERP.
  odooCalls     Int    @default(0) @map("odoo_calls")
  cacheHit      Boolean @default(false) @map("cache_hit")
  errorCode     String? @map("error_code") @db.VarChar(64)
  ip            String? @db.Inet
  userAgent     String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([apiKeyId, createdAt])
  @@index([createdAt])
  @@map("api_request_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// KIOSCO
// ─────────────────────────────────────────────────────────────────────────────

/// Tablet física en piso de venta. Se registra una vez y el SuperAdmin puede
/// revocarla si el dispositivo se pierde.
model KioskDevice {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label         String // "Tablet Mostrador 1"
  storeLocation String  @map("store_location")
  /// HMAC del device token, igual que las API keys.
  tokenHash     String  @unique @map("token_hash") @db.VarChar(64)
  isActive      Boolean @default(true) @map("is_active")

  appVersion String?   @map("app_version")
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sessions             KioskSession[]
  recommendationEvents RecommendationEvent[]

  @@map("kiosk_devices")
}

/// Sesión efímera de un cliente frente a la tablet.
/// TTL corto y borrado agresivo: es un dispositivo compartido, la sesión de un
/// cliente no puede sobrevivir al siguiente.
model KioskSession {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  deviceId String  @map("device_id") @db.Uuid
  device   KioskDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  /// Null = visitante anónimo (ve precios de lista pública, no de tarifa).
  userId String?  @map("user_id") @db.Uuid
  user   AppUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(3)
  endedReason    String?   @map("ended_reason") // logout | timeout | device_reset

  @@index([deviceId, endedAt])
  @@index([expiresAt])
  @@map("kiosk_sessions")
}

/// Telemetría del recomendador. Es el activo de datos más valioso del kiosco:
/// dice qué impresoras tiene el mercado y qué tóner deberíamos tener en stock.
model RecommendationEvent {
  id       BigInt  @id @default(autoincrement())
  deviceId String? @map("device_id") @db.Uuid
  device   KioskDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  userId String?  @map("user_id") @db.Uuid
  user   AppUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Lo que el cliente escribió, tal cual. Sin normalizar: los typos enseñan
  /// qué alias les faltan a los modelos de impresora.
  searchQuery      String  @map("search_query")
  /// asta.printer.model.id que finalmente eligió. Null = no encontró nada.
  matchedPrinterId Int?    @map("matched_printer_id")
  resultsCount     Int     @default(0) @map("results_count")
  /// product.template.id sobre el que hizo tap.
  clickedProductId Int?    @map("clicked_product_id")
  /// true si el tóner sugerido estaba sin stock: quiebre de venta medible.
  wasOutOfStock    Boolean @default(false) @map("was_out_of_stock")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([matchedPrinterId, createdAt])
  @@index([createdAt])
  @@map("recommendation_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// SOPORTE
// ─────────────────────────────────────────────────────────────────────────────

/// Cache de lectura de entidades de Odoo. Evita martillar el ERP con el
/// catálogo, que cambia poco. Se invalida por webhook desde base.automation.
model OdooEntityCache {
  odooModel String   @map("odoo_model") @db.VarChar(64) // "product.template"
  odooId    Int      @map("odoo_id")
  /// Discrimina la variante de la respuesta: la misma ficha de producto cambia
  /// según la tarifa. Para entidades sin variantes, "default".
  variant   String   @default("default") @db.VarChar(32) // "pricelist:7"
  payload   Json     @db.JsonB
  syncedAt  DateTime @default(now()) @map("synced_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([odooModel, odooId, variant])
  @@index([expiresAt])
  @@map("odoo_entity_cache")
}

/// Rastro de acciones sensibles: creación/revocación de keys, cambios de rol,
/// accesos denegados. Append-only, nunca se actualiza ni se borra.
model AuditLog {
  id      BigInt   @id @default(autoincrement())
  actorId String?  @map("actor_id") @db.Uuid
  actor   AppUser? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action     String  @db.VarChar(64) // api_key.created | user.role_changed | access.denied
  targetType String? @map("target_type") @db.VarChar(64)
  targetId   String? @map("target_id")
  metadata   Json?   @db.JsonB
  ip         String? @db.Inet

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
